[Unit]
Description=cliamp-radio web service
After=network.target

[Service]
Type=simple
User=%i
WorkingDirectory=/home/%i/cliamp-radio/server
ExecStart=/home/%i/.bun/bin/bun run index.ts
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production
# The app listens on 8000 by default; put Caddy (or another reverse proxy) in
# front of it on 80/443 for TLS — see deploy/Caddyfile and the README.
# ADMIN_USERNAME/ADMIN_PASSWORD_HASH are only consulted on first boot, before
# server/data/admin-credentials.json exists (see README) — usually you can
# leave these unset and just use the forced "changeme" -> new password flow.
# Environment=ADMIN_USERNAME=admin
# Environment=ADMIN_PASSWORD_HASH=...
# Environment=JWT_SECRET=...
# Environment=APP_VERSION=1.0.0
# Environment=GITHUB_REPO=pbaekgaard/cliamp-radio

# Allows the in-app "Install update" button to restart this service without a password prompt.
# Add a matching sudoers rule, e.g.:
#   %i ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart cliamp-radio

[Install]
WantedBy=multi-user.target
